# GDB Script for MacOS 7.1 GDB & ICMP Test Application
# This script automates GDB debugging for the test application

# Enable logging
set logging file gdb_debug.log
set logging enabled on

# Set architecture based on target
# Uncomment the appropriate line for your architecture
# set architecture m68k
# set architecture powerpc

# Connect to QEMU GDB stub
# Replace 1234 with your GDB port if different
target remote localhost:1234

# Set breakpoints at key locations
# Main application
break main
break test_gdb_function
break test_icmp_function
break handle_mouse_click

# GDB test functions
break init_gdb_test_block
break test_gdb_registers
break test_gdb_memory
break test_gdb_stack

# ICMP test functions
break icmp_init
break icmp_ping
break icmp_send_echo
break test_icmp_step_by_step

# Assembly test functions
break test_asm_68k
break test_asm_ppc
break test_fpu

# GDB label breakpoints (these are NOP instructions that can be replaced with breakpoints)
# The actual labels are at specific addresses in the compiled code
# break *0x00000400  # Example: replace with actual address from your build

# Display variables on break
# For GDB test block
# display gGDBTestBlock.magic
display gTestValue
display gTestArray

# For ICMP test
display gICMPResult

# Continue execution
continue

# When stopped at breakpoint, you can use these commands:
# info registers       - Show all registers
# info locals         - Show local variables
# backtrace           - Show call stack
# print variable_name  - Print specific variable
# step                - Step into next instruction
# next                - Step over next instruction
# continue            - Continue execution

# Architecture-specific commands:
# For 68k:
#   info registers d0 d1 d2 d3 d4 d5 d6 d7 a0 a1 a2 a3 a4 a5 a6 a7
#   print/x $d0
#   print/x $pc

# For PowerPC:
#   info registers r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15
#   print/x $r3
#   print/x $pc

# Memory examination:
# x/16xw 0x00100000  - Examine 16 words in hex
# x/16xb 0x00100000  - Examine 16 bytes in hex
# x/4gx 0x00100000   - Examine 4 giant words (64-bit)

# Common addresses to examine:
# 0x00000000-0x003FFFFF - System memory
# 0x00400000-0x007FFFFF - Application memory (68k)
# 0x01000000-0x01FFFFFF - More memory

# To quit GDB:
# quit

# Note: This is a template script. You may need to adjust breakpoints
# and addresses based on your specific build and memory layout.
