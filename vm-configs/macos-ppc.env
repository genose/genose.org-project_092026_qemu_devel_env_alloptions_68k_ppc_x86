# =============================================================================
# vm-configs/macos-ppc.env
# MacOS PPC VM configuration — Mac OS 7.5.2 – 9.2.2
# Target machine: QEMU mac99 (PowerPC G3/G4)
# =============================================================================

# --- QEMU binary ---
QEMU_BIN=qemu-system-ppc

# --- Machine / CPU ---
# mac99,via=pmu   — New World PowerMac (iMac G3, PowerMac G4)
# mac99           — generic mac99
MACHINE=mac99,via=pmu
CPU=G4
RAM_MB=256

# --- ROM / Firmware ---
# Old World Macs require a physical ROM dump (not redistributable).
# New World Macs (mac99) use OpenBIOS by default.
# If you have a ROM image, set the path below:
# BIOS_FILE=${HOME}/vm-images/macos-ppc/mac.rom

# --- Disk images ---
HDD_IMAGE=${HOME}/vm-images/macos-ppc/macos-hdd.qcow2

# Optional: installation CD-ROM
# CDROM_IMAGE=${HOME}/vm-images/macos-ppc/macos922.iso

# --- Display ---
DISPLAY_BACKEND=sdl

# --- Network ---
NETWORK_MODEL=sungem
NETWORK_TYPE=user

# --- Audio ---
AUDIO_BACKEND=sdl

# --- Boot order ---
BOOT_ORDER=c

# =============================================================================
# Example launch command:
#
# qemu-system-ppc \
#   -machine mac99,via=pmu \
#   -cpu G4 \
#   -m 256 \
#   -display sdl \
#   -audiodev sdl,id=snd0 \
#   -device VGA,vgamem_mb=16 \
#   -device usb-kbd \
#   -device usb-mouse \
#   -nic user,model=sungem \
#   -rtc base=localtime \
#   -hda ~/vm-images/macos-ppc/macos-hdd.qcow2 \
#   -cdrom ~/vm-images/macos-ppc/macos922.iso \
#   -boot d
# =============================================================================
