# =============================================================================
# vm-configs/macos-ppc.env
# MacOS PPC VM configuration — Mac OS 7.5.2 – 9.2.2
# Target machine: QEMU mac99 (PowerPC G3/G4)
# =============================================================================

# --- QEMU binary ---
QEMU_BIN=qemu-system-ppc

# --- Machine / CPU ---
# mac99,via=pmu   — New World PowerMac (iMac G3, PowerMac G4)
# mac99           — generic mac99
MACHINE=mac99,via=pmu
CPU=7455
# Common PowerPC CPU presets for this launcher: 601, 604, 7455 (G4)
RAM_MB=256

# --- SMP / Multi-processor ---
# Set SMP_SOCKETS=2 to emulate a dual-processor G4 MDD (7455×2).
# Set SMP_CORES=1 (G4 dies are single-core).
# QEMU flag produced: -smp 2,sockets=2,cores=1
SMP_SOCKETS=1
SMP_CORES=1

# --- ROM / Firmware ---
# Old World Macs require a physical ROM dump (not redistributable).
# New World Macs (mac99) use OpenBIOS by default.
# If you have a ROM image, set the path below:
# BIOS_FILE=${HOME}/vm_assistant/images/macos-ppc/mac.rom

# --- Disk images ---
HDD_IMAGE=${HOME}/vm_assistant/images/macos-ppc/macos-hdd.qcow2

# Optional: installation CD-ROM
# CDROM_IMAGE=${HOME}/vm_assistant/images/macos-ppc/macos922.iso

# --- Display ---
DISPLAY_BACKEND=sdl
DUAL_DISPLAY=no

# --- Network ---
NETWORK_MODEL=sungem
NETWORK_TYPE=user

# --- Host integration ---
# Classic Mac OS networking can consume host-provided Netatalk/AFP and TLS proxy
# services at the default SLiRP host endpoint (10.0.2.2).
SHARED_DIR=${HOME}/vm_assistant/shares
CLIPBOARD_DROP_DIR=${HOME}/vm_assistant/shares/clipboard
AFP_ENDPOINT=10.0.2.2:548
TLS_PROXY_ENDPOINT=10.0.2.2:8443
PACKAGE_MANAGER_NOTES="Prepare host-side services with MacPorts and/or Homebrew"

# Optional: expose guest gdbserver back to the host with hostfwd
# GDB_BRIDGE_PORT=2345

# --- Audio ---
AUDIO_BACKEND=sdl

# --- Boot order ---
BOOT_ORDER=c

# =============================================================================
# Example launch command (single G4):
#
# qemu-system-ppc \
#   -machine mac99,via=pmu \
#   -cpu 7455 \
#   -smp 1,sockets=1,cores=1 \
#   -m 256 \
#   -display sdl \
#   -audiodev sdl,id=snd0 \
#   -device VGA,vgamem_mb=16 \
#   -device secondary-vga,vgamem_mb=16 \
#   -device usb-kbd \
#   -device usb-mouse \
#   -nic user,model=sungem \
#   -rtc base=localtime \
#   -hda ~/vm_assistant/images/macos-ppc/macos-hdd.qcow2 \
#   -cdrom ~/vm_assistant/images/macos-ppc/macos922.iso \
#   -boot d
#
# Example launch command (dual G4 MDD — 7455×2):
#
# qemu-system-ppc \
#   -machine mac99,via=pmu \
#   -cpu 7455 \
#   -smp 2,sockets=2,cores=1 \
#   -m 512 \
#   -display sdl \
#   -audiodev sdl,id=snd0 \
#   -device VGA,vgamem_mb=16 \
#   -device secondary-vga,vgamem_mb=16 \
#   -device usb-kbd \
#   -device usb-mouse \
#   -nic user,model=sungem \
#   -rtc base=localtime \
#   -hda ~/vm_assistant/images/macos-ppc/macos-hdd.qcow2 \
#   -boot c
# =============================================================================
