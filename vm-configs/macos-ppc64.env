# =============================================================================
# vm-configs/macos-ppc64.env
# MacOS PPC G5 VM configuration — Mac OS X (ppc64, 970/970fx/970mp)
# Target machine: QEMU mac99 via qemu-system-ppc64
#
# Real hardware context:
#   970    — Power Mac G5 (single, 2003)
#   970fx  — Power Mac G5 Dual (revised die, 2004)
#   970mp  — Power Mac G5 Dual Core (dual-core die, 2005)
#
# Dual-processor models emulated with -smp 2,sockets=2,cores=1
# Dual-core die (970mp) emulated with -smp 2,sockets=1,cores=2
# =============================================================================

# --- QEMU binary ---
QEMU_BIN=qemu-system-ppc64

# --- Machine / CPU ---
# mac99,via=pmu — New World PowerMac (G5 era uses mac99 in QEMU ppc64)
MACHINE=mac99,via=pmu
CPU=970
# Supported 64-bit PowerPC CPU presets:
#   970    — first-gen G5 (single/dual socket)
#   970fx  — revised G5 (lower power, dual socket)
#   970mp  — dual-core G5 die (use sockets=1,cores=2 for dual-core)
RAM_MB=512

# --- SMP / Multi-processor ---
# Power Mac G5 Dual (2×970fx):   SMP_SOCKETS=2  SMP_CORES=1  → -smp 2,sockets=2,cores=1
# Power Mac G5 Dual Core (970mp): SMP_SOCKETS=1  SMP_CORES=2  → -smp 2,sockets=1,cores=2
# Single G5:                      SMP_SOCKETS=1  SMP_CORES=1  → -smp 1,sockets=1,cores=1
SMP_SOCKETS=1
SMP_CORES=1

# --- ROM / Firmware ---
# New World Macs (mac99) use OpenBIOS by default.
# If you have a ROM image, set the path below:
# BIOS_FILE=${HOME}/vm_assistant/images/macos-ppc64/mac.rom

# --- Disk images ---
HDD_IMAGE=${HOME}/vm_assistant/images/macos-ppc64/macos-hdd.qcow2

# Optional: installation CD-ROM (Mac OS X Tiger/Leopard ppc disc)
# CDROM_IMAGE=${HOME}/vm_assistant/isos/macos-ppc64/macosx-tiger-ppc.iso

# --- Display ---
DISPLAY_BACKEND=sdl
DUAL_DISPLAY=no

# --- Network ---
NETWORK_MODEL=sungem
NETWORK_TYPE=user

# --- Host integration ---
SHARED_DIR=${HOME}/vm_assistant/shares
CLIPBOARD_DROP_DIR=${HOME}/vm_assistant/shares/clipboard
AFP_ENDPOINT=10.0.2.2:548
TLS_PROXY_ENDPOINT=10.0.2.2:8443

# --- Audio ---
AUDIO_BACKEND=sdl

# --- Boot order ---
BOOT_ORDER=c

# =============================================================================
# Example launch command (single G5 — 970):
#
# qemu-system-ppc64 \
#   -machine mac99,via=pmu \
#   -cpu 970 \
#   -smp 1,sockets=1,cores=1 \
#   -m 512 \
#   -display sdl \
#   -audiodev sdl,id=snd0 \
#   -device VGA,vgamem_mb=16 \
#   -device usb-kbd \
#   -device usb-mouse \
#   -nic user,model=sungem \
#   -rtc base=localtime \
#   -hda ~/vm_assistant/images/macos-ppc64/macos-hdd.qcow2
#
# Example launch command (Power Mac G5 Dual — 2×970fx):
#
# qemu-system-ppc64 \
#   -machine mac99,via=pmu \
#   -cpu 970fx \
#   -smp 2,sockets=2,cores=1 \
#   -m 1024 \
#   -display sdl \
#   -audiodev sdl,id=snd0 \
#   -device VGA,vgamem_mb=16 \
#   -device secondary-vga,vgamem_mb=16 \
#   -device usb-kbd \
#   -device usb-mouse \
#   -nic user,model=sungem \
#   -rtc base=localtime \
#   -hda ~/vm_assistant/images/macos-ppc64/macos-hdd.qcow2
#
# Example launch command (Power Mac G5 Dual Core — 970mp, 1 socket × 2 cores):
#
# qemu-system-ppc64 \
#   -machine mac99,via=pmu \
#   -cpu 970mp \
#   -smp 2,sockets=1,cores=2 \
#   -m 1024 \
#   -display sdl \
#   -audiodev sdl,id=snd0 \
#   -device VGA,vgamem_mb=16 \
#   -device usb-kbd \
#   -device usb-mouse \
#   -nic user,model=sungem \
#   -rtc base=localtime \
#   -hda ~/vm_assistant/images/macos-ppc64/macos-hdd.qcow2
# =============================================================================
