# =============================================================================
# vm-configs/amiga.env
# Amiga VM configuration (Motorola 68k)
# =============================================================================
#
# QEMU does not emulate Amiga custom chips (Agnus, Denise, Paula, CIA).
# For classic AmigaOS use FS-UAE or WinUAE (most accurate).
# For an open-source AmigaOS-compatible environment use AROS via QEMU m68k.
# vm_assist.sh offers both options.
# =============================================================================

# --- Emulator preference ---
# aros-qemu  — AROS Research OS on QEMU m68k (open source, no ROM required)
# fs-uae     — FS-UAE (most accurate, requires AmigaOS ROMs)
EMULATOR_PREFERENCE=aros-qemu

# ---- FS-UAE settings (used when EMULATOR_PREFERENCE=fs-uae) ----
# FS-UAE reads its config from ~/.config/fs-uae/Configurations/
# Place your .fs-uae config files there.
# https://fs-uae.net/docs/configuration

# Path to Kickstart ROM (not redistributable — dump your own or use Amiga Forever)
# KICKSTART_ROM=${HOME}/vm_assistant/images/amiga/kick13.rom

# ---- AROS / QEMU settings (used when EMULATOR_PREFERENCE=aros-qemu) ----
QEMU_BIN=qemu-system-m68k
MACHINE=virt
CPU=m68040
# Other supported 68k-family CPU presets often used with QEMU:
# m68000, m68010, m68020, m68030, m68040
RAM_MB=128

# AROS m68k disk image: https://aros.sourceforge.io/nightly.php
HDD_IMAGE=${HOME}/vm_assistant/images/amiga-aros/aros-disk.qcow2

DISPLAY_BACKEND=sdl
NETWORK_TYPE=user
AUDIO_BACKEND=sdl

# =============================================================================
# Example AROS / QEMU command:
#
# qemu-system-m68k \
#   -machine virt \
#   -cpu m68040 \
#   -m 128 \
#   -display sdl \
#   -audiodev sdl,id=snd0 \
#   -nic user \
#   -rtc base=localtime \
#   -hda ~/vm_assistant/images/amiga-aros/aros-disk.qcow2
#
# Example FS-UAE launch (config in ~/.config/fs-uae/Configurations/amiga.fs-uae):
#
# fs-uae ~/.config/fs-uae/Configurations/amiga.fs-uae
# =============================================================================
