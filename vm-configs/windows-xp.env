# =============================================================================
# vm-configs/windows-xp.env
# Windows XP VM configuration (i386)
# =============================================================================

# --- QEMU binary ---
QEMU_BIN=qemu-system-i386

# --- Machine / CPU ---
MACHINE=pc
CPU=pentium3
RAM_MB=1024
CPU_CORES=2

# --- Disk images ---
HDD_IMAGE=${HOME}/vm_assistant/images/windows-xp/windows-xp-hdd.qcow2
# CDROM_IMAGE=${HOME}/vm_assistant/isos/windows-xp/winxp-install.iso

# --- Display ---
DISPLAY_BACKEND=sdl

# --- Network ---
NETWORK_MODEL=rtl8139
NETWORK_TYPE=user

# Optional: built-in SMB export for moving files into the guest
SMB_SHARE=${HOME}/vm_assistant/shares

# Optional: hostfwd for guest services such as gdbserver or HTTP
# PORT_FORWARDS=2345:2345,8080:80

# =============================================================================
# Example launch command:
#
# qemu-system-i386 \
#   -machine pc \
#   -cpu pentium3 \
#   -m 1024 \
#   -smp 2 \
#   -display sdl \
#   -audiodev sdl,id=snd0 \
#   -device VGA,vgamem_mb=16 \
#   -device usb-ehci \
#   -device usb-kbd \
#   -device usb-mouse \
#   -nic user,model=rtl8139,smb=~/vm_assistant/shares \
#   -rtc base=localtime \
#   -hda ~/vm_assistant/images/windows-xp/windows-xp-hdd.qcow2
# =============================================================================
