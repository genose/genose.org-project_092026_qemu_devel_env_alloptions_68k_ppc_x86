# =============================================================================
# vm-configs/haiku.env
# HaikuOS VM configuration (i386 / x86_64)
# =============================================================================
# Download Haiku: https://www.haiku-os.org/get-haiku
# =============================================================================

# --- Architecture ---
# x86_64  — recommended for Haiku R1 Beta 5+
# i386    — for 32-bit Haiku or older releases
ARCH=x86_64

# --- QEMU binary ---
# QEMU_BIN is derived from ARCH by vm_assist.sh (qemu-system-${ARCH})
# Override here if needed:
# QEMU_BIN=qemu-system-x86_64

# --- Machine / CPU ---
MACHINE=q35
CPU=host           # use 'qemu64' if KVM is unavailable
RAM_MB=1024
CPU_CORES=2

# --- KVM hardware acceleration ---
# yes — use KVM (Linux hosts only, /dev/kvm required, much faster)
# no  — software emulation only
KVM_ENABLE=yes

# --- Disk images ---
HDD_IMAGE=${HOME}/vm-images/haiku-x86_64/haiku-hdd.qcow2

# Optional: Haiku installation anyboot image (works as both HD image and ISO)
# CDROM_IMAGE=${HOME}/vm-images/haiku-x86_64/haiku-r1beta5-x86_64-anyboot.iso

# --- Display ---
# sdl, gtk, vnc, curses, none
DISPLAY_BACKEND=sdl

# --- Network ---
NETWORK_MODEL=e1000
NETWORK_TYPE=user

# --- Shared directory (9P VirtFS) ---
SHARED_DIR=${HOME}/vm-shared

# =============================================================================
# Example launch command:
#
# qemu-system-x86_64 \
#   -machine q35 \
#   -cpu host \
#   -m 1024 \
#   -smp 2 \
#   -enable-kvm \
#   -display sdl \
#   -audiodev sdl,id=snd0 \
#   -device VGA,vgamem_mb=32 \
#   -device usb-ehci \
#   -device usb-kbd \
#   -device usb-mouse \
#   -nic user,model=e1000 \
#   -rtc base=localtime \
#   -virtfs local,path=~/vm-shared,mount_tag=shared,security_model=mapped-xattr \
#   -hda ~/vm-images/haiku-x86_64/haiku-hdd.qcow2
# =============================================================================
