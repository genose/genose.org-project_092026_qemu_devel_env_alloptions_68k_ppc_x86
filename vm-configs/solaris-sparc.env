# =============================================================================
# vm-configs/solaris-sparc.env
# Solaris SPARC VM configuration (sun4u / qemu-system-sparc64)
# =============================================================================

# --- QEMU binary ---
QEMU_BIN=qemu-system-sparc64

# --- Machine / CPU ---
MACHINE=sun4u
CPU="TI UltraSparc IIi"
RAM_MB=1024

# --- Disk images ---
HDD_IMAGE=${HOME}/vm_assistant/images/solaris-sparc/solaris-sparc-hdd.qcow2
# CDROM_IMAGE=${HOME}/vm_assistant/isos/solaris-sparc/solaris-sparc-install.iso

# --- Display ---
DISPLAY_BACKEND=sdl

# --- Network ---
NETWORK_MODEL=sunhme
NETWORK_TYPE=user

# Optional: hostfwd for guest services such as gdbserver
# PORT_FORWARDS=2345:2345

# =============================================================================
# Example launch command:
#
# qemu-system-sparc64 \
#   -machine sun4u \
#   -cpu "TI UltraSparc IIi" \
#   -m 1024 \
#   -display sdl \
#   -audiodev sdl,id=snd0 \
#   -nic user,model=sunhme \
#   -rtc base=localtime \
#   -hda ~/vm_assistant/images/solaris-sparc/solaris-sparc-hdd.qcow2
# =============================================================================
