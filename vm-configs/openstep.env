# =============================================================================
# vm-configs/openstep.env
# OpenStep x86 VM configuration
# =============================================================================

# --- QEMU binary ---
QEMU_BIN=qemu-system-i386

# --- Machine / CPU ---
MACHINE=pc
CPU=pentium
RAM_MB=256

# --- Disk images ---
HDD_IMAGE=${HOME}/vm-images/openstep/openstep-hdd.qcow2
# CDROM_IMAGE=${HOME}/vm-images/openstep/openstep-install.iso

# --- Display ---
DISPLAY_BACKEND=sdl

# --- Network ---
NETWORK_MODEL=ne2k_pci
NETWORK_TYPE=user

# Optional: built-in SMB export for moving files into the guest when supported
# SMB_SHARE=${HOME}/vm-shared

# Optional: hostfwd for guest services such as gdbserver
# PORT_FORWARDS=2345:2345

# =============================================================================
# Example launch command:
#
# qemu-system-i386 \
#   -machine pc \
#   -cpu pentium \
#   -m 256 \
#   -display sdl \
#   -audiodev sdl,id=snd0 \
#   -device VGA,vgamem_mb=8 \
#   -nic user,model=ne2k_pci \
#   -rtc base=localtime \
#   -hda ~/vm-images/openstep/openstep-hdd.qcow2
# =============================================================================
