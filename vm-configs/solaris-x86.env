# =============================================================================
# vm-configs/solaris-x86.env
# Solaris x86 VM configuration (Solaris 8/9/10 x86, illumos-family experiments)
# =============================================================================

# --- QEMU binary ---
QEMU_BIN=qemu-system-i386

# --- Machine / CPU ---
MACHINE=pc
CPU=pentium3
RAM_MB=1024
CPU_CORES=2

# --- Disk images ---
HDD_IMAGE=${HOME}/vm_assistant/images/solaris-x86/solaris-hdd.qcow2
# CDROM_IMAGE=${HOME}/vm_assistant/isos/solaris-x86/solaris-install.iso

# --- Display ---
DISPLAY_BACKEND=sdl

# --- Network ---
NETWORK_MODEL=e1000
NETWORK_TYPE=user

# Optional: host SMB export via QEMU user networking for guest file exchange
# SMB_SHARE=${HOME}/vm_assistant/shares

# Optional: hostfwd for guest services such as gdbserver
# PORT_FORWARDS=2345:2345,8080:80

# =============================================================================
# Example launch command:
#
# qemu-system-i386 \
#   -machine pc \
#   -cpu pentium3 \
#   -m 1024 \
#   -smp 2 \
#   -display sdl \
#   -audiodev sdl,id=snd0 \
#   -device VGA,vgamem_mb=16 \
#   -device usb-kbd \
#   -device usb-mouse \
#   -nic user,model=e1000 \
#   -rtc base=localtime \
#   -hda ~/vm_assistant/images/solaris-x86/solaris-hdd.qcow2
# =============================================================================
