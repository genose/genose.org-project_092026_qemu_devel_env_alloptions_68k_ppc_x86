# =============================================================================
# vm-configs/atari.env
# Atari ST / STE / TT / Falcon VM configuration (Motorola 68k)
# =============================================================================
#
# IMPORTANT: For the most accurate Atari emulation use Hatari:
#   https://hatari.tuxfamily.org/
# vm_assist.sh will auto-detect Hatari if installed and prefer it.
# This file documents both Hatari and QEMU m68k options.
# =============================================================================

# --- Emulator preference ---
# hatari — use Hatari (recommended for Atari ST/STE/TT/Falcon)
# qemu   — use QEMU m68k virt machine (less accurate, experimental)
EMULATOR_PREFERENCE=hatari

# ---- Hatari settings (used when EMULATOR_PREFERENCE=hatari) ----

# Path to TOS ROM image (required for Hatari).
# EmuTOS is a free open-source replacement: https://emutos.sourceforge.io/
TOS_IMAGE=${HOME}/vm_assistant/images/atari/tos206.img

# Hatari machine type: ST, STE, TT, FALCON
HATARI_MACHINE=STE

# Hatari RAM in KiB (512, 1024, 2048, 4096, 8192, 14336 for ST/STE;
# up to 32768 for TT; up to 65536 for Falcon)
HATARI_RAM_KB=4096

# Hard disk directory (VirtHD) — maps a host directory as a GEMDOS drive
HATARI_HARDDRIVE=${HOME}/vm_assistant/images/atari/harddrive

# ---- QEMU settings (used when EMULATOR_PREFERENCE=qemu) ----
QEMU_BIN=qemu-system-m68k
MACHINE=virt
CPU=m68040
# Other supported 68k-family CPU presets often used with QEMU:
# m68000, m68010, m68020, m68030, m68040
RAM_MB=14
HDD_IMAGE=${HOME}/vm_assistant/images/atari/atari-disk.qcow2
DISPLAY_BACKEND=sdl

# =============================================================================
# Example Hatari command:
#
# hatari --machine ste --tos ~/vm_assistant/images/atari/tos206.img \
#        --harddrive ~/vm_assistant/images/atari/harddrive \
#        --memsize 4 --sound on
#
# Example EmuTOS Hatari command (no proprietary ROM needed):
#
# hatari --machine ste --tos ~/vm_assistant/images/atari/emutos.img \
#        --harddrive ~/vm_assistant/images/atari/harddrive
# =============================================================================
