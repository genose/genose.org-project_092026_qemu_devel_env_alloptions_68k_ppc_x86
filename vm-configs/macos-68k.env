# =============================================================================
# vm-configs/macos-68k.env
# MacOS 68k VM configuration — System 7.1 – Mac OS 8.1
# Target machine: QEMU q800 (Motorola 68040 — Quadra 800)
# =============================================================================

# --- QEMU binary ---
QEMU_BIN=qemu-system-m68k

# --- Machine / CPU ---
MACHINE=q800
CPU=m68040
RAM_MB=128

# --- Disk images ---
# Place your MacOS 68k hard disk image here.
# Recommended format: qcow2 (saves space via copy-on-write)
HDD_IMAGE=${HOME}/vm-images/macos-68k/macos-hdd.qcow2

# Optional: CD-ROM / installation ISO
# CDROM_IMAGE=${HOME}/vm-images/macos-68k/system71.iso

# --- Display ---
# sdl  — SDL2 window (default, good for desktop use)
# gtk  — GTK window
# vnc  — VNC server on port 5900 (headless use)
# none — no display (useful for debugging)
DISPLAY_BACKEND=sdl

# --- Network ---
# user  — built-in user-mode networking (no root required)
# tap   — bridged TAP (requires root / network setup)
NETWORK_MODEL=dp83932
NETWORK_TYPE=user

# --- Audio ---
AUDIO_BACKEND=sdl

# --- Boot order ---
# c = first hard disk, d = first CD-ROM, n = network
BOOT_ORDER=c

# =============================================================================
# Example launch command (generated by vm_assist.sh):
#
# qemu-system-m68k \
#   -machine q800 \
#   -cpu m68040 \
#   -m 128 \
#   -display sdl \
#   -audiodev sdl,id=snd0 \
#   -device nubus-macfb \
#   -nic user,model=dp83932 \
#   -rtc base=localtime \
#   -hda ~/vm-images/macos-68k/macos-hdd.qcow2
# =============================================================================
